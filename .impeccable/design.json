      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Revision action.",
      "html": "<button class=\"ds-button-primary\">Approve revision</button>",
      "css": ".ds-button-primary{font:550 16px/1.4 -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;display:inline-block;border:1px solid var(--signal,#9a561f);background:var(--signal,#9a561f);color:var(--on-accent,#fdf6ee);border-radius:5px;padding:11px 18px;min-height:44px;cursor:pointer;}.ds-button-primary:hover{filter:brightness(1.08)}.ds-button-primary:focus-visible{outline:2px solid var(--signal-hot,#7d4211);outline-offset:4px}.ds-button-primary:disabled{opacity:.45;cursor:not-allowed;background:var(--inset,#e0dbcc);color:var(--text-muted,#56594e);border-color:var(--line,#c3bcaa);}"
