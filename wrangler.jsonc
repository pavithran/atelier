{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atelier",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  // Workers Logs: the account keeps every invocation and every console.*
  // line the Worker writes (seven days, three on the free plan) — read them
  // in the dashboard under Workers & Pages → atelier → Observability, or
  // live with wrangler tail; docs/orchestrating.md, "Reading the server's
  // logs", says how a session queries them. test/workers-logs.test.mjs
  // keeps the logs free of tokens and keys.
  "observability": { "enabled": true },
  "routes": [{ "pattern": "atelier.zone", "custom_domain": true }],
  "workers_dev": false,
  // The daily model snapshots (t623, takeModelSnapshots in src/index.ts):
  // every six hours, so a run that fails or finds a project unreadable is
  // tried again within the day; a run with nothing due writes nothing. The
  // list replaces whatever schedules an earlier deploy left on the Worker.
  // Every 10 minutes the stuck rules are evaluated for each project and the
  // opened and cleared episodes recorded (t196, recordStuckEpisodes).
  // Every 5 minutes each live task's stage is read against its limit and the
  // stage events recorded (t223, recordStageTicks).
  "triggers": { "crons": ["*/5 * * * *", "*/10 * * * *", "7 */6 * * *"] },
  // Cloudflare Access in front of the owner's pages (src/access.ts): set all
  // three, as vars or secrets, and the Worker verifies the Access assertion
  // on every owner route — /login and its token form among them — against the
  // keys the team publishes, matching the issuer, the audience and the
  // owner's email claim. The issuer is the team's URL; the audience is the
  // Access application's AUD tag; the email is the one person the pages are
  // for. Each public path (/api/*, /how, /live.js) needs its own
  // Access application with a Bypass policy, since bearer tokens and visitors
  // never pass Access (docs/setup.md says how). Set all three or none: with
  // only some set, or one unusable, the owner's routes are refused.
  //   "vars": {
  //     "CF_ACCESS_ISS": "https://TEAM.cloudflareaccess.com",
  //     "CF_ACCESS_AUD": "<the application's AUD tag>",
  //     "CF_ACCESS_OWNER_EMAIL": "owner@example.com"
  //   }
  "vars": {
    // The Cloudflare account that holds the AI Gateway is the secret
    // CF_ACCOUNT_ID (README, "AI Gateway costs"), so the public source names
    // no account; unset, the gateway figures are not read.
    // The gateway runners send their calls through, whose figures the
    // Models page reads from the GraphQL Analytics API.
    "AI_GATEWAY_ID": "atelier"
  },
  "rules": [{ "type": "Text", "globs": ["**/*.css"], "fallthrough": true }],
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "atelier", "remote": true }],
  // Large payloads by reference (t284): whole check logs and review diffs are
  // kept in R2 and named by their key in briefs and the ledger, instead of
  // carried inline — an 888 KB review diff broke a review on 2026-10-07. The
  // owner creates the bucket before deploying: npx wrangler r2 bucket create
  // atelier-large. Where no bucket answers the binding, nothing large is
  // stored and briefs and the ledger carry what they always did.
  "r2_buckets": [{ "binding": "LARGE", "bucket_name": "atelier-large" }],
  "durable_objects": {
    "bindings": [
      { "name": "LEDGER", "class_name": "Ledger" }
    ]
  },
  // The landing pipeline as a Cloudflare Workflow (src/landing-workflow.ts),
  // used only by `atelier land ID --workflow` (docs/landing.md): one instance
  // per landing waits for the observed results of the checks the developer's
  // machine ran, then the submission and the review wait without the landing lease, then takes
  // the lease for the acceptance and the merge alone, as durable steps with
  // retries, and waits for the developer's machine to merge main, push, run
  // the checks and merge. At the
  // default polls a landing takes under 3,000 steps, well inside the
  // default limit of 10,000.
  "workflows": [{ "name": "landing", "binding": "LANDING_WORKFLOW", "class_name": "LandingWorkflow" }],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Ledger"] },
    { "tag": "v2", "new_sqlite_classes": ["CheckRunner"] },
    // t768 removed the container check; this deletes the class and its data.
    { "tag": "v3", "deleted_classes": ["CheckRunner"] }
  ]
}
