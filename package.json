{
  "name": "atelier",
  "version": "1.0.0",
  "description": "A Git platform for agents on Cloudflare Workers and Artifacts: one owner per item, observed evidence, a human inbox.",
  "scripts": {
    "test": "node test/run.mjs",
    "typecheck": "tsc -p . && tsc -p test",
    "design:capture": "node scripts/design/capture.ts"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.1",
    "playwright-core": "1.61.1",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@5.9.3",
    "vitest": "^4.1.11"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "atelier": "cli/atelier.mjs"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
