{
  "name": "atelier",
  "version": "1.0.0",
  "description": "A Git platform for agents on Cloudflare Workers and Artifacts: one owner per item, observed evidence, a human inbox.",
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\" \"test/**/*.test.mjs\" && vitest run",
    "typecheck": "tsc -p . && tsc -p test",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.6",
    "@cloudflare/workers-types": "^5.20261003.1",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  },
  "private": true,
  "bin": {
    "atelier": "cli/atelier.mjs"
  }
}
