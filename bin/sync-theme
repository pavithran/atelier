#!/bin/sh
# Copy the portfolio's rendered theme tokens in. ai-projects-design owns them;
# this file is a copy, never an edit. Run after that project re-renders.
set -eu
here="$(cd "$(dirname "$0")/.." && pwd)"
src="$here/../ai-projects-design/rendered/themes.css"
{ printf '/* Copied from ai-projects-design/rendered/themes.css by bin/sync-theme. Do not edit. */\n'; cat "$src"; } > "$here/src/theme.css"
echo "theme synced from $src"
