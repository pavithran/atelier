<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The nightly backup of one Atelier environment to R2 (docs/studio.md),
     as atelierd. setup-backup.sh fills @ENV@, @HOME@, @SERVER@, @HOUR@ and @MINUTE@
     and installs it as /Library/LaunchDaemons/zone.atelier.backup.@ENV@.plist. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>zone.atelier.backup.@ENV@</string>
  <key>UserName</key><string>atelierd</string>
  <key>GroupName</key><string>atelierd</string>
  <key>ProgramArguments</key>
  <array>
    <string>@HOME@/bin/node</string>
    <string>@HOME@/@SERVER@/cli/backup.mjs</string>
    <string>--env</string><string>@ENV@</string>
    <string>--data</string><string>@HOME@/data/@ENV@</string>
    <string>--repos</string><string>@HOME@/repos/@ENV@</string>
    <string>--secrets</string><string>@HOME@/secrets/backup</string>
    <string>--work</string><string>@HOME@/backup-work</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>ATELIER_GIT</key><string>/Library/Developer/CommandLineTools/usr/bin/git</string>
    <key>HOME</key><string>@HOME@</string>
  </dict>
  <key>WorkingDirectory</key><string>@HOME@</string>
  <key>Umask</key><integer>63</integer>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>@HOUR@</integer>
    <key>Minute</key><integer>@MINUTE@</integer>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>@HOME@/log/backup-@ENV@.log</string>
  <key>StandardErrorPath</key><string>@HOME@/log/backup-@ENV@.log</string>
</dict>
</plist>
