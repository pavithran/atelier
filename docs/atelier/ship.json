{
  "schema_version": 1,
  "kind": "atelier.ship",
  "class": "web",
  "description": "Atelier's own delivery from main, to the staging server on the Studio: type-check; when the server's code changed since the commit next.atelier.zone reports, install the captured commit on the Studio with root's installer under sudo, which builds the release itself from the Studio's repository; the developer types the password at sudo's own prompt; verify the live commit; scan for private data; push main to the github remote.",
  "typecheck": {
    "run": [
      "npm",
      "run",
      "typecheck"
    ],
    "timeout_seconds": 600
  },
  "deploy": {
    "run": [
      "node",
      "scripts/ship-studio.mjs",
      "deploy",
      "--env",
      "staging",
      "--version-url",
      "https://next.atelier.zone/api/version",
      "--host",
      "ai-studio"
    ],
    "terminal": true,
    "timeout_seconds": 1200,
    "if_changed": {
      "paths": [
        "src/**",
        "cli/serve.mjs",
        "cli/private-guard.mjs",
        "hooks/**",
        "package.json",
        "package-lock.json"
      ],
      "since": "https://next.atelier.zone/api/version"
    }
  },
  "verify-deploy": {
    "run": [
      "node",
      "scripts/ship-studio.mjs",
      "verify",
      "--version-url",
      "https://next.atelier.zone/api/version"
    ],
    "timeout_seconds": 90
  },
  "scan": {
    "run": [
      "node",
      "scripts/privacy-scan.mjs",
      "--remote",
      "github",
      "--branch",
      "main",
      "--project",
      "atelier"
    ],
    "timeout_seconds": 300
  },
  "push": {
    "remote": "github",
    "branch": "main"
  }
}
