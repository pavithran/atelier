{
  "schema_version": 1,
  "kind": "atelier.ship",
  "class": "web",
  "description": "Atelier's own delivery from main, to staging since the v1.0 cut: type-check; deploy the captured source commit to the staging Worker (next.atelier.zone) when Worker code changed since the live one, then verify its live binding; scan for private data; push main to the github remote; update the baseline; fast-forward the Studio checkout.",
  "typecheck": {
    "run": ["npm", "run", "typecheck"],
    "timeout_seconds": 600
  },
  "deploy": {
    "run": [
      "node",
      "scripts/ship-worker.mjs",
      "deploy",
      "--env",
      "staging"
    ],
    "timeout_seconds": 1200,
    "retries": 1,
    "if_changed": {
      "paths": ["src/**", "wrangler.jsonc", "package.json", "package-lock.json", "worker-configuration.d.ts", "tsconfig.json"],
      "since": "https://next.atelier.zone/api/version"
    }
  },
  "verify-deploy": {
    "run": [
      "node",
      "scripts/ship-worker.mjs",
      "verify",
      "--version-url",
      "https://next.atelier.zone/api/version"
    ],
    "timeout_seconds": 45
  },
  "scan": {
    "run": ["node", "scripts/privacy-scan.mjs", "--remote", "github", "--branch", "main", "--project", "atelier"],
    "timeout_seconds": 300
  },
  "push": {
    "remote": "github",
    "branch": "main"
  },
  "baseline": {
    "run": ["node", "cli/atelier.mjs", "sync", "--project", "atelier"],
    "timeout_seconds": 300
  },
  "studio": {
    "run": ["node", "scripts/studio-ff.mjs", "--remote", "origin", "--branch", "main", "--checkout", "/Users/pavi/ai-projects/atelier", "--host", "studio"],
    "timeout_seconds": 120
  }
}
