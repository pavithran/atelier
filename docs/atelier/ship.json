{
  "schema_version": 1,
  "kind": "atelier.ship",
  "class": "web",
  "description": "Atelier 1.0 delivery from release/1.0: type-check; deploy the captured source commit to production when Worker code changed since the live one, then verify its live binding; scan for private data; push release/1.0 to the github remote; update the baseline; fast-forward the Studio 1.0 checkout.",
  "typecheck": {
    "run": ["npm", "run", "typecheck"],
    "timeout_seconds": 600
  },
  "deploy": {
    "run": ["node", "scripts/ship-worker.mjs", "deploy"],
    "timeout_seconds": 1200,
    "retries": 1,
    "if_changed": {
      "paths": ["src/**", "wrangler.jsonc", "package.json", "package-lock.json", "worker-configuration.d.ts", "tsconfig.json"],
      "since": "https://atelier.zone/api/version"
    }
  },
  "verify-deploy": {
    "run": ["node", "scripts/ship-worker.mjs", "verify"],
    "timeout_seconds": 45
  },
  "scan": {
    "run": ["node", "scripts/privacy-scan.mjs", "--remote", "github", "--branch", "release/1.0", "--project", "atelier-1.0"],
    "timeout_seconds": 300
  },
  "push": {
    "remote": "github",
    "branch": "release/1.0"
  },
  "baseline": {
    "run": ["node", "cli/atelier.mjs", "sync", "--project", "atelier-1.0"],
    "timeout_seconds": 300
  },
  "studio": {
    "run": ["node", "scripts/studio-ff.mjs", "--remote", "origin", "--branch", "release/1.0", "--checkout", "/Users/pavi/ai-projects/atelier-1.0", "--host", "studio"],
    "timeout_seconds": 120
  }
}
