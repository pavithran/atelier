#!/usr/bin/env node
// Atelier's pre-receive hook (Atelier 2.0, tasks 2 and 3; design section 4.4): write
// isolation on one repository. The server runs `git receive-pack` as its own
// user with the grant in the environment (src/git/http.mjs); this hook,
// named by core.hooksPath and out of every agent's reach, refuses each ref
// update the grant does not cover.
//   1. One ref per push, the one the grant names: task tN and refresh tN
//      (a task refresh's leaseholder) write refs/heads/t/N, plan tN
//      refs/heads/plan/N, landing the project's
//      branch, owner the project's branch and refs/heads/dev/*. Landing and
//      owner also write Atelier's provenance notes, refs/notes/atelier, on a
//      push of their own; a task or plan grant never does.
//   2. No deletes; the server deletes task branches itself.
//   3. Fast-forward only on the project's branch, plan/* and the notes ref.
//   4. A landing push is a merge whose first parent is the branch's tip and
//      whose parents include the accepted head; a landing grant updates the
//      branch once (the server takes that update at step 7). The owner's
//      credential only creates the project's branch in an empty repository:
//      after that only a landing moves it (task 6).
// Then, for a push those four allow, the two rules that read the pushed
// files (src/git/scan.mjs), with the policy the server wrote for this push
// (ATELIER_POLICY, src/git/policy.mjs):
//   5. The secret scan of the commits the push adds; a key-shaped line the
//      owner has not cleared refuses the push, naming file and line.
//   6. The private-file guard: no commit adds a private path.
//   7. The grant is still live, asked of the server at hook time.
import { gitCommand } from "../src/git/command.mjs";
import { execFileSync } from "node:child_process";
import { readFileSync } from "node:fs";

const ZERO = /^0+$/;
const { ATELIER_KIND: kind = "", ATELIER_TASK: task = "", ATELIER_BRANCH: branch = "", ATELIER_ACCEPTED: accepted = "", ATELIER_POLICY: policy = "", ATELIER_REPORT: report = "" } = process.env;

function refuse(message) {
  process.stderr.write(`atelier: ${message}\n`);
  process.exit(1);
}

const n = /^t(\d+)$/.exec(task)?.[1];
const NOTES = "refs/notes/atelier";
const writes = {
  task: n && { test: (r) => r === `refs/heads/t/${n}`, text: `t/${n}` },
  refresh: n && { test: (r) => r === `refs/heads/t/${n}`, text: `t/${n}` },
  plan: n && { test: (r) => r === `refs/heads/plan/${n}`, text: `plan/${n}` },
  landing: branch && { test: (r) => r === `refs/heads/${branch}` || r === NOTES, text: `${branch} and ${NOTES}` },
  owner: branch && { test: (r) => r === `refs/heads/${branch}` || r === NOTES || /^refs\/heads\/dev\/[^/].*$/.test(r), text: `${branch}, dev/* and ${NOTES}` },
}[kind];
if (!writes) refuse("this credential writes nothing here");

const lines = readFileSync(0, "utf8").split("\n").filter(Boolean);
if (lines.length !== 1) refuse(`one ref per push; this credential writes ${writes.text} only`);
const [old, sha, ref] = lines[0].split(" ");
if (!writes.test(ref)) refuse(`this credential writes ${writes.text} only, not ${ref.replace(/^refs\/heads\//, "")}`);
if (ZERO.test(sha)) refuse(`no deletes: ${ref.replace(/^refs\/heads\//, "")} stays; the server deletes task branches itself`);

const git = (...args) => execFileSync(gitCommand(), args, { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }).trim();
const guarded = ref === `refs/heads/${branch}` || ref.startsWith("refs/heads/plan/") || ref === NOTES;
if (guarded && !ZERO.test(old)) {
  try { git("merge-base", "--is-ancestor", old, sha); } catch { refuse(`${ref.replace(/^refs\/heads\//, "")} moves by fast-forward only`); }
}
if (kind === "owner" && ref === `refs/heads/${branch}` && !ZERO.test(old)) {
  refuse(`${branch} moves only by a landing, which carries the reviewed head; this credential creates ${branch} in an empty repository and writes dev/* and ${NOTES}, nothing was pushed. next: atelier land tN, for the task that holds the change`);
}
if (kind === "landing" && ref === `refs/heads/${branch}`) {
  if (ZERO.test(old)) refuse(`a landing merges onto ${branch}, which has no tip yet`);
  const parents = git("rev-list", "--parents", "-n", "1", sha).split(" ").slice(1);
  if (parents[0] !== old) refuse(`a landing's first parent is ${branch}'s tip ${old.slice(0, 12)}`);
  if (!/^[0-9a-f]{40}$/.test(accepted) || !parents.includes(accepted)) refuse(`a landing merges the accepted head ${accepted.slice(0, 12) || "(none)"}, which this commit's parents do not include`);
}
// The server writes a policy for every push it serves; a push without one
// is not scanned, so it is refused.
if (!policy) refuse("this push has no scan policy from the server; nothing was pushed");
await import("../src/runtime/loader.mjs");
const { checkPush } = await import("../src/git/scan.mjs");
const refusal = await checkPush({ old, sha, ref, branch, task, policyPath: policy, reportPath: report });
if (refusal) refuse(refusal);
// 7. Last, the grant is asked about again, at the server: a push let in
// while its grant was live is refused when the grant was revoked, or its task
// handed over, given up or closed, while the pack was still arriving. A grant
// the server does not confirm, or a server that does not answer, refuses.
const { ATELIER_GRANT: grant = "", ATELIER_GRANT_CHECK: check = "", ATELIER_HOOK_SECRET: secret = "" } = process.env;
if (!check || !secret) refuse("this push has no way to check its credential with the server; nothing was pushed");
let live = false;
try {
  const res = await fetch(check, { method: "POST", headers: { "content-type": "application/json", "x-atelier-hook-secret": secret }, body: JSON.stringify({ grant, branch: ref === `refs/heads/${branch}`, sha }), signal: AbortSignal.timeout(10_000) });
  live = res.ok && (await res.json()).live === true;
} catch { /* unanswered: not live */ }
if (!live) refuse(kind === "landing"
  ? "this landing credential is no longer live, or has already updated the project's branch once: the landing lease was released or taken over, the acceptance moved, or the merge is recorded; nothing was pushed. next: atelier merge TASK again, which asks for a new one"
  : "this credential is no longer live: the task was handed over, released, closed or its token revoked while the push arrived; nothing was pushed");
